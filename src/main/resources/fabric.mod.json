{
	"schemaVersion": 1,
	"id": "environment-attribute-getter",
	"version": "${version}",
	"name": "Environment Attribute Getter",
	"description": "Provider more ways to get environment attribute",
	"authors": [
		"wplx-7"
	],
	"contact": {
		"sources": "https://github.com/wplx-7/environment-attribute-getter"
	},
	"license": "MIT",
	"icon": "assets/environment_attribute_getter/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.wplx_7.environmentattributegetter.EnvironmentAttributeGetter"
		],
		"client": [
			"io.github.wplx_7.environmentattributegetter.client.EnvironmentAttributeGetterClient"
		]
	},
	"mixins": [
		"environment-attribute-getter.mixins.json",
		{
			"config": "environment-attribute-getter.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}